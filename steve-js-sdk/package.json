{
  "name": "transport-security-service-worker",
  "version": "0.2.0",
  "description": "End-to-end encryption for web apps running in TEE enclaves",
  "type": "module",
  "main": "dist/register.js",
  "exports": {
    ".": "./dist/register.js",
    "./service-worker": "./dist/enclave-sw.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node build-wasm.js && node build.js",
    "build:js": "node build.js",
    "build:e2e": "node build-wasm.js && node build.js --eval",
    "watch": "node build.js --watch",
    "test": "node --test test/*.test.js",
    "test:wasm": "node build-wasm.js && node --test test/wasm/*.test.js",
    "test:wasm:built": "node --test test/wasm/*.test.js",
    "test:e2e": "playwright test --config test/e2e/playwright.config.js"
  },
  "keywords": [
    "tee",
    "enclave",
    "encryption",
    "service-worker",
    "attestation",
    "verifiable",
    "confidential compute"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/caution/transport-security-service-worker.git"
  },
  "dependencies": {
    "tee-attestation-js": "git+https://git.distrust.co/public/tee-attestation-js.git#bca7b2ab0b819f66148dd58cd397958554dd1ad4"
  },
  "devDependencies": {
    "@noble/post-quantum": "0.6.1",
    "@playwright/test": "1.61.1",
    "esbuild": "0.25.0"
  }
}
