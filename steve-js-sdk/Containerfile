FROM stagex/core-git@sha256:6b3e0055f6aeaa8465f207a871db2c63a939cd7406113e9d769ff3b37239f3d0 AS git
FROM stagex/core-ca-certificates@sha256:d135f1189e9b232eb7316626bf7858534c5540b2fc53dced80a4c9a95f26493e AS ca-certificates
FROM stagex/core-curl@sha256:bc8bab43d96a9167fbb85022ea773644a45ef335e7a9b747f203078973fa988e AS curl

FROM --platform=linux/amd64 stagex/pallet-rust@sha256:abe9b95c93a5afa271f69fcd5eb18c8cd405fe5df6491a63c9418e3a170573dc AS wasm-builder

COPY --from=git . /
COPY --from=ca-certificates . /
COPY --from=curl . /

ENV CARGO_HOME=/tmp/cargo-home
ENV CARGO_INCREMENTAL=0
ENV CARGO_TARGET_DIR=/tmp/cargo-target
ENV RUSTC_BOOTSTRAP=1
ENV SOURCE_DATE_EPOCH=1

WORKDIR /build

RUN cargo install --locked --version '=0.2.106' \
      --root /opt/wasm-bindgen wasm-bindgen-cli && \
    test "$(/opt/wasm-bindgen/bin/wasm-bindgen --version)" = \
      "wasm-bindgen 0.2.106"

COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

RUN cargo fetch --locked && \
    cargo fetch -Z build-std=std,panic_abort \
      --locked --target wasm32-unknown-unknown && \
    cargo build -Z build-std=std,panic_abort \
      --locked --offline --release \
      --package steve-xwing-wasm \
      --target wasm32-unknown-unknown && \
    /opt/wasm-bindgen/bin/wasm-bindgen \
      /tmp/cargo-target/wasm32-unknown-unknown/release/steve_xwing_wasm.wasm \
      --target web \
      --out-dir /out \
      --out-name steve_xwing_wasm \
      --no-typescript

FROM --platform=linux/amd64 stagex/pallet-nodejs@sha256:1f705b58321b17e87ea68c04431ad83be6e6b64253d0443be4c61501902d57c3 AS node-deps

COPY --from=git . /
COPY --from=ca-certificates . /
COPY --from=curl . /

WORKDIR /build

COPY steve-js-sdk/package.json steve-js-sdk/package-lock.json ./
RUN npm ci --ignore-scripts

FROM node-deps AS unit-test

COPY steve-js-sdk/src/ ./src/
COPY steve-js-sdk/test/ ./test/
COPY test-vectors/ /test-vectors/

RUN npm test

FROM node-deps AS builder

COPY steve-js-sdk/build.js ./
COPY steve-js-sdk/src/ ./src/
COPY --from=wasm-builder /out/ ./wasm-pkg/

RUN npm run build:js

FROM builder AS test

COPY steve-js-sdk/test/ ./test/
COPY test-vectors/ /test-vectors/
COPY steve-js-sdk/README.md ./

RUN npm test && \
    npm run test:wasm:built && \
    npm pack --dry-run

FROM scratch AS output

COPY --from=test /build/dist/ /build/dist/
CMD ["true"]
