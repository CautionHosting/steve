FROM --platform=linux/amd64 stagex/pallet-rust@sha256:9c38bf1066dd9ad1b6a6b584974dd798c2bf798985bf82e58024fbe0515592ca AS steve-builder

ENV SOURCE_DATE_EPOCH=1
ENV CARGO_INCREMENTAL=0
ENV CARGO_TARGET_DIR=/tmp/cargo-target
ENV RUSTFLAGS="-C codegen-units=1 -C target-feature=+crt-static -C link-arg=-Wl,--build-id=none"

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY test-vectors/ ./test-vectors/
COPY tests/e2e/fixtures/ ./tests/e2e/fixtures/

RUN cargo build --release --locked --target x86_64-unknown-linux-musl \
    -p steve --features eval-attestation --bin steve-eval && \
    install -Dm755 \
      /tmp/cargo-target/x86_64-unknown-linux-musl/release/steve-eval \
      /out/steve-eval

FROM scratch AS steve-eval
COPY --from=steve-builder /out/steve-eval /steve-eval
ENTRYPOINT ["/steve-eval"]

FROM --platform=linux/amd64 stagex/pallet-nodejs@sha256:1f705b58321b17e87ea68c04431ad83be6e6b64253d0443be4c61501902d57c3 AS fixture

WORKDIR /fixture
COPY tests/e2e/fixture-server.mjs /fixture/fixture-server.mjs
COPY tests/e2e/public/ /fixture/public/
RUN chmod 0644 /fixture/fixture-server.mjs && \
    find /fixture/public -type d -exec chmod 0755 {} + && \
    find /fixture/public -type f -exec chmod 0644 {} +

ENTRYPOINT ["node", "/fixture/fixture-server.mjs"]
